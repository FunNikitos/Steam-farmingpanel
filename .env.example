# ============================================
# Telegram Bot
# ============================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_USER_ID=your_telegram_id_here

# ============================================
# Steam Web API
# ============================================
# Get your key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# ============================================
# ArchiSteamFarm (ASF)
# ============================================
ASF_IPC_URL=http://steam-panel-asf:1242
ASF_IPC_PASSWORD=your_asf_password_here

# ============================================
# Database
# ============================================
DB_PATH=/app/data/panel.db

# ============================================
# Scheduler (Cron expressions)
# ============================================
# Giveaways scan - every day at 10:00
SCAN_CRON=0 10 * * *

# Hours sync - every hour
SYNC_CRON=0 * * * *

# Deals scan - every day at 11:00
DEALS_CRON=0 11 * * *
